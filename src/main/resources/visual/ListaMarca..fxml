<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaMarcaController" prefWidth="600" prefHeight="450">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Marcas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaMarcas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID Marca" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre de la Marca" prefWidth="450"/>
        </columns>
    </TableView>

    <TitledPane text="Editar / Eliminar Marca" expanded="true">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Nombre:"/>
            <TextField fx:id="txtNombre" HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            <Button text="Limpiar" onAction="#handleLimpiar"/>
        </HBox>
    </TitledPane>
</VBox>