<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaLaptopController" prefWidth="850" prefHeight="550">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Laptops" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaLaptops" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID Laptop" prefWidth="80"/>
            <TableColumn fx:id="colNombre" text="Nombre Comercial" prefWidth="160"/>
            <TableColumn fx:id="colModelo" text="No. Modelo" prefWidth="120"/>
            <TableColumn fx:id="colProcesador" text="Procesador" prefWidth="150"/>
            <TableColumn fx:id="colRam" text="RAM (GB)" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio Detalle" prefWidth="120"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
        </columns>
    </TableView>

    <TitledPane text="Editar / Eliminar Laptop" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="No. Modelo:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtModelo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Procesador:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtProcesador" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="RAM (GB):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtRam" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Precio Detalle:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="txtStock" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4" alignment="CENTER_RIGHT">
                <Button text="Actualizar" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                <Button text="Limpiar" onAction="#handleLimpiar"/>
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>