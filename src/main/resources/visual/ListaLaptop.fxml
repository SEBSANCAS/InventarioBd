<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="visual.ListaLaptopController" prefWidth="950" prefHeight="650">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión Avanzada de Laptops" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1c3f6e;"/>

    <TableView fx:id="tablaLaptops" VBox.vgrow="ALWAYS"
               style="-fx-text-background-color: #2c3e50; -fx-font-size: 13px;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID Laptop" prefWidth="80"/>
            <TableColumn fx:id="colNombre" text="Nombre Comercial" prefWidth="130"/>
            <TableColumn fx:id="colModelo" text="Modelo" prefWidth="90"/>
            <TableColumn fx:id="colProcesador" text="Procesador" prefWidth="120"/>
            <TableColumn fx:id="colGpu" text="GPU" prefWidth="110"/>
            <TableColumn fx:id="colRam" text="RAM (GB)" prefWidth="70"/>
            <TableColumn fx:id="colAlmacenamiento" text="Almacenamiento" prefWidth="110"/>
            <TableColumn fx:id="colGarantia" text="Garantía (Meses)" prefWidth="100"/>
            <TableColumn fx:id="colPrecio" text="Precio Detalle" prefWidth="90"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="60"/>
        </columns>
    </TableView>

    <TitledPane text="Editar / Eliminar Laptop" expanded="true">
        <GridPane hgap="12" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
            </columnConstraints>

            <Label text="Nombre Comercial:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="No. Modelo:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtModelo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Procesador:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtProcesador" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Tarjeta Gráfica (GPU):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtGpu" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="RAM (GB):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtRam" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Almacenamiento (GB):" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="txtAlmacenamiento" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <Label text="Meses Garantía:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtGarantia" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Precio Detalle:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <TextField fx:id="txtPrecio" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <Label text="Stock Actual:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="4" alignment="CENTER_RIGHT">
                <Button text="Actualizar" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Limpiar" onAction="#handleLimpiar" style="-fx-cursor: hand;"/>
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>