<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.VentanaListadosController" prefWidth="450" prefHeight="250"
      style="-fx-background-color: #ecf0f1;">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Selecciona el Listado que deseas consultar"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <ComboBox fx:id="cbListados" prefWidth="300"
              style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Abrir Listado" onAction="#handleAbrirListado"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#handleCancelar"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
    </HBox>
</VBox>