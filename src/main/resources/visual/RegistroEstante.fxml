<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="420.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.RegistroEstanteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Registro de Estante" textFill="#1c3f6e">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Código de Estante:" />
            <TextField fx:id="campoIdEstante" promptText="Ej: EST-01" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Capacidad Total:" />
            <TextField fx:id="campoCapacidad" promptText="Mayor a 0" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Cantidad de Niveles:" />
            <TextField fx:id="campoNiveles" promptText="Mayor a 0" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <Label fx:id="lblMensaje" wrapText="true" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#ControlarGuardar" style="-fx-background-color: #1c3f6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Guardar" />
                <Button mnemonicParsing="false" onAction="#ControlarLimpiar" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-radius: 3; -fx-padding: 7 14;" text="Limpiar" />
                <Button mnemonicParsing="false" onAction="#ControlarCancelar" style="-fx-background-color: transparent; -fx-text-fill: #b23b3b; -fx-font-weight: bold; -fx-padding: 8 15;" text="Cancelar" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>