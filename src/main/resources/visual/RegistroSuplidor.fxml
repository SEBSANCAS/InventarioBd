<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: white; -fx-background-color: white;" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.RegistroSuplidorController">
    <VBox spacing="20" style="-fx-background-color: white;">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Registro de Suplidor" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c3f6e;"/>
        <Label text="Complete los datos del nuevo suplidor comercial." style="-fx-font-size: 13px; -fx-text-fill: #7a7a7a;"/>

        <Separator/>

        <GridPane hgap="18" vgap="16">
            <columnConstraints>
                <ColumnConstraints minWidth="170" prefWidth="170"/>
                <ColumnConstraints minWidth="380" prefWidth="420" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="ID Suplidor:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="campoIdSuplidor" editable="false" promptText="Auto-generado por el sistema"
                       prefHeight="34" maxWidth="Infinity"
                       style="-fx-background-color: #f2f2f2; -fx-border-color: #d6d6d6; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Razón Comercial:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="campoRazonComercial" promptText="Razón social legal"
                       prefHeight="34" maxWidth="Infinity"
                       style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Nombre Comercial:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="campoNombreComercial" promptText="Nombre comercial o marca"
                       prefHeight="34" maxWidth="Infinity"
                       style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Tipo Identificación:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboTipoIdentificacion"
                      prefHeight="34" prefWidth="420" maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4;"
                      GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label fx:id="lblIdentificacion" text="Número de Identificación:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="campoIdentificacion" promptText="000000000"
                       prefHeight="34" maxWidth="Infinity"
                       style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Correo:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="campoCorreo" promptText="suplidor@correo.com"
                       prefHeight="34" maxWidth="Infinity"
                       style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Ciudad:" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboCiudad" promptText="Seleccione una ciudad"
                      prefHeight="34" prefWidth="420" maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-border-color: #AEDFF7; -fx-border-radius: 4; -fx-background-radius: 4;"
                      GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
        </GridPane>

        <Separator/>

        <Label text="Teléfonos de Contacto:" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1c3f6e;"/>
        <VBox fx:id="contenedorTelefonos" spacing="10"/>

        <HBox alignment="CENTER_LEFT">
            <Button text="+ Agregar teléfono" onAction="#ControlarAgregarTelefono" style="-fx-background-color: #eaf4fc; -fx-text-fill: #1c3f6e; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="lblMensaje" wrapText="true" style="-fx-font-size: 12px;"/>

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button text="Cancelar" onAction="#ControlarCancelar" style="-fx-background-color: white; -fx-text-fill: #b23b3b; -fx-border-color: #b23b3b; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
            <Button text="Limpiar Campos" onAction="#ControlarLimpiar" style="-fx-background-color: #e6e6e6; -fx-text-fill: #333333; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
            <Button text="Guardar / Registrar" onAction="#ControlarGuardar" style="-fx-background-color: #1c3f6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</ScrollPane>