<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="visual.MenuPrincipalController"
            prefWidth="1200"
            prefHeight="700"
            minWidth="1100"
            minHeight="650"
            stylesheets="@estiloMenu.css"
            styleClass="root">
    <top>

        <VBox>

            <HBox styleClass="header">

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <FontIcon iconLiteral="fas-laptop"
                              iconSize="28"
                              iconColor="white"/>

                    <Label text="Inventario de Laptops"
                           styleClass="titulo"/>

                </HBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Label text="Administrador"
                       styleClass="usuario"/>

            </HBox>

            <MenuBar styleClass="menuBar">

                <Menu text="Rentabilidad"/>

                <Menu text="Informes"/>

                <Menu text="Información"/>

            </MenuBar>

        </VBox>

    </top>
    <center>

        <GridPane
                fx:id="panelPrincipal"
                styleClass="panelPrincipal"
                hgap="15"
                vgap="15"
               alignment="CENTER">
            <columnConstraints>

                <ColumnConstraints percentWidth="32.3"/>

                <ColumnConstraints percentWidth="32.3"/>

                <ColumnConstraints percentWidth="32.4"/>

            </columnConstraints>
            <rowConstraints>

                <RowConstraints percentHeight="33"/>

                <RowConstraints percentHeight="33"/>

                <RowConstraints percentHeight="34"/>

            </rowConstraints>

            <StackPane GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="12">

                    <FontIcon iconLiteral="fas-folder-plus"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <MenuButton
                            fx:id="btnRegistros"
                            text="Registros"
                            styleClass="botonMenu">

                        <items>

                            <MenuItem text="Registrar Marca"
                                      onAction="#ControlarRegistrarMarca"/>

                            <MenuItem text="Registrar Modelo de Laptop"
                                      onAction="#ControlarRegistrarModelo"/>

                            <MenuItem text="Registrar Cliente"
                                      onAction="#ControlarRegistrarCliente"/>

                            <MenuItem text="Registrar Suplidor"
                                      onAction="#ControlarRegistrarSuplidor"/>

                            <MenuItem text="Registrar Estante"
                                      onAction="#ControlarRegistrarEstante"/>

                        </items>

                    </MenuButton>

                    <Label text="Clientes, marcas, laptops y estantes."
                           wrapText="true"
                           styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       styleClass="card">

                <VBox alignment="CENTER" spacing="18">

                    <FontIcon iconLiteral="fas-table"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button fx:id="btnListados"
                            text="Listados"
                            styleClass="botonCard"
                            onAction="#ControlarListados"/>

                    <Label text="Consultar toda la información registrada."
                           wrapText="true"
                           styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-boxes"
                              iconSize="45"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnMovimientoInventario"
                            text="Movimiento de Inventario"
                            wrapText="true"
                            styleClass="botonCard"
                            onAction="#ControlarMovimientoInventario"/>

                    <Label
                            text="Entradas, salidas y movimientos del almacén."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-handshake"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnContratoSuplidor"
                            text="Contrato Suplidor"
                            styleClass="botonCard"
                            onAction="#ControlarContratoSuplidor"/>

                    <Label
                            text="Gestiona acuerdos con proveedores."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="1"
                       GridPane.rowIndex="1"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-shopping-cart"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnOrdenar"
                            text="Ordenar"
                            styleClass="botonCard"
                            onAction="#ControlarOrdenar"/>

                    <Label
                            text="Crear nuevas órdenes de compra."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="2"
                       GridPane.rowIndex="1"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-cash-register"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnRealizarVenta"
                            text="Realizar Venta"
                            styleClass="botonCard"
                            onAction="#ControlarRealizarVenta"/>

                    <Label
                            text="Facturación y venta de equipos."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-clipboard-list"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnManejarOrdenes"
                            text="Manejar Órdenes"
                            styleClass="botonCard"
                            onAction="#ControlarManejarOrdenes"/>

                    <Label
                            text="Administrar órdenes de compra."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-exclamation-triangle"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnRegistrarReclamo"
                            text="Registrar Reclamo"
                            styleClass="botonCard"
                            onAction="#abrirRegistroReclamo"/>

                    <Label
                            text="Registrar incidencias y garantías."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
            <StackPane GridPane.columnIndex="2"
                       GridPane.rowIndex="2"
                       styleClass="card">

                <VBox alignment="CENTER"
                      spacing="18">

                    <FontIcon iconLiteral="fas-check-circle"
                              iconSize="34"
                              iconColor="#1565C0"/>

                    <Button
                            fx:id="btnResolverReclamo"
                            text="Resolver Reclamo"
                            styleClass="botonCard"
                            onAction="#ControlarResolverReclamo"/>

                    <Label
                            text="Dar seguimiento y solución a reclamos."
                            wrapText="true"
                            styleClass="descripcion"/>

                </VBox>

            </StackPane>
        </GridPane>
    </center>

    <right>

        <VBox fx:id="panelNotificaciones"
              prefWidth="260"
              spacing="18"
              styleClass="panelDerecho">

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <FontIcon iconLiteral="fas-bell"
                          iconSize="22"
                          iconColor="#1565C0"/>

                <Label text="Notificaciones"
                       styleClass="tituloPanel"/>

            </HBox>

            <Separator/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="scrollNotificaciones">

                <content>

                    <VBox fx:id="listaAlertas"
                          spacing="15"
                          styleClass="contenedorAlertas"/>

                </content>

            </ScrollPane>

        </VBox>

    </right>

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15"
              style="-fx-background-color:#1565C0;
             -fx-padding:10;">

            <Label text="Sistema de Inventario de Laptops"
                   style="-fx-text-fill:white;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblHora"
                   style="-fx-text-fill:white;"/>

        </HBox>

    </bottom>
</BorderPane>