<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaAdquisicionController" prefWidth="850" prefHeight="500">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Adquisiciones / Compras" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaAdquisiciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID Compra" prefWidth="110"/>
            <TableColumn fx:id="colSuplidor" text="Suplidor" prefWidth="180"/>
            <TableColumn fx:id="colFechaEmision" text="Fecha Emisión" prefWidth="130"/>
            <TableColumn fx:id="colFechaEntrega" text="Fecha Entrega" prefWidth="130"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colTotal" text="Monto Total" prefWidth="130"/>
        </columns>
    </TableView>

    <TitledPane text="Modificar Estado / Eliminar Registro" expanded="true">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Nuevo Estado:"/>
            <ComboBox fx:id="cbEstado" prefWidth="180"/>

            <Button text="Actualizar Estado" onAction="#handleActualizarEstado" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Eliminar Registro" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            <Button text="Limpiar" onAction="#handleLimpiar"/>
        </HBox>
    </TitledPane>
</VBox>