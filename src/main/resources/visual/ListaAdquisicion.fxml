<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaAdquisicionController" prefWidth="850" prefHeight="550"
      style="-fx-background-color: #ecf0f1;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Historial y Listado de Adquisiciones" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="tablaAdquisiciones" VBox.vgrow="ALWAYS"
               style="-fx-text-background-color: #2c3e50; -fx-control-inner-background: #ffffff; -fx-font-size: 13px;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID Compra"/>
            <TableColumn fx:id="colSuplidor" text="Suplidor"/>
            <TableColumn fx:id="colFechaEmision" text="Fecha Emisión"/>
            <TableColumn fx:id="colFechaEntrega" text="Fecha Entrega"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
            <TableColumn fx:id="colTotal" text="Monto Total"/>
        </columns>
    </TableView>

    <TitledPane text="Modificar Estado / Eliminar Adquisición" expanded="true">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Nuevo Estado:"/>
            <ComboBox fx:id="cbEstado" prefWidth="180"/>

            <Button text="Actualizar Estado" onAction="#handleActualizarEstado" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Eliminar Registro" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Limpiar" onAction="#handleLimpiar"/>
        </HBox>
    </TitledPane>
</VBox>