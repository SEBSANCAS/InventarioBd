<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="600.0" spacing="10.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.RegistroLaptopController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <Label text="Registro de Modelo / Laptop" textFill="#1c3f6e">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="ID Laptop:" />
                        <TextField fx:id="campoIdLaptop" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Marca:" />
                        <ComboBox fx:id="comboMarca" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Número de Modelo:" />
                        <TextField fx:id="campoNumeroModelo" promptText="Ej: 15-dy2093dx" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Nombre Comercial:" />
                        <TextField fx:id="campoNombreComercial" promptText="Ej: HP Pavilion 15" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Procesador:" />
                        <ComboBox fx:id="comboProcesador" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="GPU:" />
                        <ComboBox fx:id="comboGpu" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Tipo RAM:" />
                        <ComboBox fx:id="comboTipoRam" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label text="Cantidad RAM (GB):" />
                        <TextField fx:id="campoCantidadRam" promptText="Ej: 16" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <Label text="Tipo Almacenamiento:" />
                        <ComboBox fx:id="comboTipoAlmacenamiento" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <Label text="Capacidad Alm. (GB):" />
                        <TextField fx:id="campoCantidadAlmacenamiento" promptText="Ej: 512" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="5">
                        <Label text="Tamaño Pantalla (Pulg):" />
                        <TextField fx:id="campoTamanoPantalla" promptText="Ej: 15.6" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                        <Label text="Resolución:" />
                        <ComboBox fx:id="comboResolucion" prefWidth="Infinity" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="6">
                        <Label text="Peso (lb):" />
                        <TextField fx:id="campoPeso" promptText="Ej: 3.5" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                        <Label text="Meses de Garantía:" />
                        <TextField fx:id="campoGarantia" promptText="Ej: 12" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="7">
                        <Label text="Precio Detalle (DOP):" />
                        <TextField fx:id="campoPrecioDetalle" promptText="Ej: 45000" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                        <Label text="Precio Mayorista (DOP):" />
                        <TextField fx:id="campoPrecioMayorista" promptText="Ej: 40000" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="8">
                        <Label text="Cant. Min. Mayorista:" />
                        <TextField fx:id="campoCantMinMayorista" promptText="Ej: 5" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="8">
                        <Label text="Cant. Alerta Stock:" />
                        <TextField fx:id="campoCantAlerta" promptText="Ej: 3" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </VBox>
                </GridPane>
            </content>
        </ScrollPane>

        <Label fx:id="lblMensaje" wrapText="true" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#ControlarGuardar" style="-fx-background-color: #1c3f6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Guardar" />
                <Button mnemonicParsing="false" onAction="#ControlarLimpiar" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-radius: 3; -fx-padding: 7 14;" text="Limpiar" />
                <Button mnemonicParsing="false" onAction="#ControlarCancelar" style="-fx-background-color: transparent; -fx-text-fill: #b23b3b; -fx-font-weight: bold; -fx-padding: 8 15;" text="Cancelar" />
            </children>
        </HBox>
    </children>
</VBox>