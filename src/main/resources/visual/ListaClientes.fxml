<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaClientesController" prefWidth="900" prefHeight="580"
      style="-fx-background-color: #ecf0f1;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión y Listado de Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
               style="-fx-text-background-color: #2c3e50; -fx-control-inner-background: #ffffff; -fx-font-size: 13px;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID Cliente"/>
            <TableColumn fx:id="colTipoCliente" text="Tipo Cliente"/>
            <TableColumn fx:id="colTipoIdentificacion" text="Tipo ID"/>
            <TableColumn fx:id="colIdentificacion" text="No. Identificación"/>
            <TableColumn fx:id="colNombres" text="Nombres"/>
            <TableColumn fx:id="colApellidos" text="Apellidos"/>
            <TableColumn fx:id="colCorreo" text="Correo"/>
        </columns>
    </TableView>

    <TitledPane text="Editar Cliente" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Deshabilitados para impedir la modificación de estos tipos -->
            <Label text="Tipo Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbTipoCliente" disable="true" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Tipo Identificación:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbTipoIdentificacion" disable="true" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="No. Identificación:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtIdentificacion" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Nombres:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombres" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4" alignment="CENTER_RIGHT">
                <Button text="Actualizar" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Limpiar" onAction="#handleLimpiar"/>
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>