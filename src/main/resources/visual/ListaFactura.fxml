<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaFacturaController" prefWidth="900" prefHeight="550"
      style="-fx-background-color: #ecf0f1;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Historial y Listado de Facturación" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="tablaFacturas" VBox.vgrow="ALWAYS"
               style="-fx-text-background-color: #2c3e50; -fx-control-inner-background: #ffffff; -fx-font-size: 13px;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID Factura"/>
            <TableColumn fx:id="colComprobante" text="No. Comprobante"/>
            <TableColumn fx:id="colCliente" text="Cliente"/>
            <TableColumn fx:id="colFecha" text="Fecha Emisión"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal"/>
            <TableColumn fx:id="colImpuestos" text="Impuestos"/>
            <TableColumn fx:id="colTotal" text="Monto Total"/>
        </columns>
    </TableView>

    <TitledPane text="Modificar Comprobante / Anular Factura" expanded="true">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="No. Comprobante:"/>
            <TextField fx:id="txtComprobante" HBox.hgrow="ALWAYS"/>

            <Button text="Actualizar Comprobante" onAction="#handleActualizarComprobante" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Anular / Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Limpiar" onAction="#handleLimpiar"/>
        </HBox>
    </TitledPane>
</VBox>