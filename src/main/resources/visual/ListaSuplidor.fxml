<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="visual.ListaSuplidorController" prefWidth="800" prefHeight="520">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Suplidores" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaSuplidores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID Suplidor" prefWidth="90"/>
            <TableColumn fx:id="colNombreComercial" text="Nombre Comercial" prefWidth="180"/>
            <TableColumn fx:id="colRazonComercial" text="Razón Social" prefWidth="180"/>
            <TableColumn fx:id="colIdentificacion" text="No. Identificación" prefWidth="130"/>
            <TableColumn fx:id="colCorreo" text="Correo Electrónico" prefWidth="180"/>
        </columns>
    </TableView>

    <TitledPane text="Editar / Eliminar Suplidor" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Nombre Comercial:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombreComercial" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Razón Comercial:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtRazonComercial" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="No. Identificación:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtIdentificacion" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="4" alignment="CENTER_RIGHT">
                <Button text="Actualizar" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                <Button text="Limpiar" onAction="#handleLimpiar"/>
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>