<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650" prefWidth="950" spacing="10" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.ListaEquipoController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Gestión de Inventario de Equipos" />

    <TableView fx:id="tablaEquipos" style="-fx-text-background-color: #2c3e50; -fx-control-inner-background: #ffffff; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" prefWidth="90" text="ID Equipo" />
            <TableColumn fx:id="colLaptop" prefWidth="100" text="ID Laptop" />
            <TableColumn fx:id="colSerie" prefWidth="140" text="Número Serie" />
            <TableColumn fx:id="colColor" prefWidth="90" text="Color" />
            <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
            <TableColumn fx:id="colDisponibilidad" prefWidth="120" text="Disponibilidad" />
            <TableColumn fx:id="colDescuento" prefWidth="100" text="Descuento" />
            <TableColumn fx:id="colFecha" prefWidth="110" text="Fecha Ingreso" />
        </columns>
    </TableView>

    <TitledPane expanded="true" text="Editar / Eliminar Equipo">
        <GridPane hgap="12" vgap="12">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="180" />
                <ColumnConstraints minWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="180" />
            </columnConstraints>

            <Label text="Número de Serie:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtSerie" promptText="S/N del equipo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Color:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtColor" promptText="Ej. Gris Espacial" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="comboEstado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Disponibilidad:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="comboDisponibilidad" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Fecha Ingreso:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <DatePicker fx:id="dateFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Descuento Condición:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtDescuento" promptText="Ej. 0.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="3">
                <Button onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Actualizar" />
                <Button onAction="#handleEliminar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar" />
                <Button onAction="#handleLimpiar" style="-fx-cursor: hand;" text="Limpiar" />
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>