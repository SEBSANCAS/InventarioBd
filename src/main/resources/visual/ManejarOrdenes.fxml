<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.ManejarOrdenesController" prefWidth="850" prefHeight="600">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Manejar Órdenes y Compras" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1c3f6e;"/>

    <!-- BOX SUPERIOR: ÓRDENES REALIZADAS (PENDIENTES) -->
    <TitledPane text="Órdenes Pendientes por Aprobar" expanded="true" VBox.vgrow="ALWAYS" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;">
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- TODO EL STYLE COMBINADO EN UNA SOLA LÍNEA DENTRO DE LA ETIQUETA -->
            <TableView fx:id="tablaPendientes" prefHeight="180" VBox.vgrow="ALWAYS" style="-fx-base: white; -fx-control-inner-background: white; -fx-table-cell-border-color: #e0e0e0; -fx-text-background-color: #2c3e50; -fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPendId" text="ID Orden" prefWidth="100" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colPendSuplidor" text="Suplidor" prefWidth="220" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colPendFecha" text="Fecha Emisión" prefWidth="140" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colPendTotal" text="Monto Total" prefWidth="150" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colPendEstado" text="Estado" prefWidth="120" style="-fx-text-fill: #b23b3b; -fx-font-weight: bold;"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Aceptar Orden" onAction="#handleAceptarOrden" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Rechazar Orden" onAction="#handleRechazarOrden" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- BOX INFERIOR: ÓRDENES ACEPTADAS -->
    <TitledPane text="Órdenes Aceptadas en Espera de Envío" expanded="true" VBox.vgrow="ALWAYS" style="-fx-font-weight: bold; -fx-text-fill: #1c3f6e;">
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- TODO EL STYLE COMBINADO TAMBIÉN AQUÍ -->
            <TableView fx:id="tablaAceptadas" prefHeight="180" VBox.vgrow="ALWAYS" style="-fx-base: white; -fx-control-inner-background: white; -fx-table-cell-border-color: #e0e0e0; -fx-text-background-color: #2c3e50; -fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colAceptId" text="ID Orden" prefWidth="100" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colAceptSuplidor" text="Suplidor" prefWidth="220" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colAceptFecha" text="Fecha Emisión" prefWidth="140" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colAceptTotal" text="Monto Total" prefWidth="150" style="-fx-text-fill: #333333;"/>
                    <TableColumn fx:id="colAceptEstado" text="Estado" prefWidth="120" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="📦 ¡La compra llegó!" onAction="#handleCompraLlego" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>