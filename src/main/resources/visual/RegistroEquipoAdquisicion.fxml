<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="visual.RegistroEquipoAdquisicionController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1c3f6e;" text="Registrar Ingreso de Equipo" />
    <Label fx:id="lblContexto" style="-fx-text-fill: #7a7a7a; -fx-font-size: 12px;" text="Modelo: --" wrapText="true" />

    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label style="-fx-font-weight: bold;" text="ID Equipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="campoIdEquipo" editable="false" style="-fx-background-color: #f2f2f2; -fx-border-color: #d6d6d6; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-font-weight: bold;" text="No. Serie:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="campoSerial" promptText="S/N del equipo" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-weight: bold;" text="Color:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="campoColor" promptText="Ej. Plateado" style="-fx-border-color: #AEDFF7; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <Label fx:id="lblMensaje" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#ControlarCancelar" style="-fx-background-color: transparent; -fx-text-fill: #b23b3b; -fx-font-weight: bold;" text="Cancelar" />
        <Button mnemonicParsing="false" onAction="#ControlarGuardar" style="-fx-background-color: #1c3f6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Registrar Ingreso" />
    </HBox>
</VBox>